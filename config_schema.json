{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ECCOS Simulator Configuration Schema",
  "description": "Unified JSON Schema for ECCOS scenario and solver configuration files.",
  "type": "object",
  "$defs": {
    "distribution": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "exponential",
            "uniform",
            "normal",
            "lognormal",
            "weibull",
            "pareto",
            "beta",
            "zipf",
            "integers",
            "constant"
          ]
        },
        "scale": {
          "type": "number"
        },
        "mean": {
          "type": "number"
        },
        "sigma": {
          "type": "number"
        },
        "low": {
          "type": "number"
        },
        "high": {
          "type": "number"
        },
        "a": {
          "type": "number"
        },
        "b": {
          "type": "number"
        },
        "value": {
          "type": "number"
        },
        "cloud": {
          "$ref": "#/$defs/distribution"
        }
      },
      "required": [
        "type"
      ]
    },
    "target_resolution": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "single",
            "group",
            "all",
            "zone",
            "attribute"
          ]
        },
        "group_config": {
          "type": "object",
          "properties": {
            "strategy": {
              "type": "string"
            },
            "num_elements": {
              "type": "integer"
            },
            "percentage": {
              "type": "number"
            },
            "zone_id": {
              "type": "string"
            },
            "attribute_name": {
              "type": "string"
            },
            "threshold": {
              "type": "number"
            }
          }
        }
      }
    },
    "action_frequency": {
      "type": "object",
      "properties": {
        "frequency": {
          "$ref": "#/$defs/distribution"
        },
        "impact": {
          "type": "object"
        }
      },
      "required": [
        "frequency"
      ]
    },
    "sub_action": {
      "type": "object",
      "properties": {
        "type_object": {
          "type": "string"
        },
        "action_type": {
          "type": "string"
        },
        "impact_params": {
          "type": "object"
        },
        "target_attributes_loss": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "target_attributes_multiplier": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "p_loss_dist": {
          "$ref": "#/$defs/distribution"
        },
        "multiplier_dist": {
          "$ref": "#/$defs/distribution"
        },
        "distribution_to_clear_edge": {
          "$ref": "#/$defs/distribution"
        },
        "distribution_to_enable_node": {
          "$ref": "#/$defs/distribution"
        },
        "distribution_to_restore_node": {
          "$ref": "#/$defs/distribution"
        }
      },
      "required": [
        "type_object",
        "action_type"
      ]
    },
    "global_action": {
      "type": "object",
      "properties": {
        "type_object": {
          "type": "string"
        },
        "action_type": {
          "type": "string"
        },
        "frequency": {
          "$ref": "#/$defs/distribution"
        },
        "impact": {
          "type": "object",
          "properties": {
            "num_new_users": {
              "type": [
                "integer",
                "number"
              ]
            },
            "composed_of": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/sub_action"
              }
            }
          }
        }
      },
      "required": [
        "frequency"
      ]
    }
  },
  "properties": {
    "scenario_name": {
      "type": "string"
    },
    "solver_name": {
      "type": "string"
    },
    "seeds": {
      "type": "object",
      "properties": {
        "master": {
          "type": "integer"
        },
        "graph": {
          "type": "integer"
        },
        "app": {
          "type": "integer"
        },
        "user": {
          "type": "integer"
        },
        "event": {
          "type": "integer"
        }
      }
    },
    "infrastructure": {
      "type": "object",
      "properties": {
        "num_nodes": {
          "type": "integer",
          "minimum": 1
        },
        "model": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "enum": [
                "scale_free",
                "erdos_renyi",
                "spatial",
                "fat_tree",
                "tree",
                "multi_tier",
                "barabasi_albert"
              ]
            },
            "m": {
              "type": "integer"
            },
            "p": {
              "type": "number"
            },
            "radius": {
              "type": "number"
            },
            "branching_r": {
              "type": "integer"
            },
            "branching_h": {
              "type": "integer"
            },
            "cloud": {
              "type": "object"
            },
            "fog": {
              "type": "object"
            },
            "layer": {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": [
                    "centrality_based_layer",
                    "depth_based_layer",
                    "manual"
                  ]
                },
                "thresholds": {
                  "type": "object",
                  "properties": {
                    "cloud_min": {
                      "type": "number"
                    },
                    "fog_min": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          },
          "required": [
            "name"
          ]
        },
        "node": {
          "type": "object",
          "properties": {
            "attributes": {
              "type": "object"
            },
            "actions": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/action_frequency"
              }
            }
          }
        },
        "edge": {
          "type": "object",
          "properties": {
            "attributes": {
              "type": "object"
            },
            "actions": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/action_frequency"
              }
            }
          }
        }
      },
      "required": [
        "num_nodes",
        "model"
      ]
    },
    "app": {
      "type": "object",
      "properties": {
        "num_apps": {
          "type": "integer",
          "minimum": 1
        },
        "architecture": {
          "type": [
            "string",
            "object"
          ]
        },
        "services": {
          "type": "object",
          "properties": {
            "network": {
              "type": "object"
            },
            "topology_model": {
              "type": "string"
            },
            "scale_free_settings": {
              "type": "object"
            },
            "num_services_range": {
              "type": "array",
              "items": {
                "type": "integer"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "profiles": {
              "type": "object"
            }
          }
        },
        "popularity": {
          "type": "object",
          "properties": {
            "distribution": {
              "$ref": "#/$defs/distribution"
            },
            "local_app_ratio": {
              "type": "number"
            },
            "local_radius_influence": {
              "type": "number"
            }
          }
        },
        "num_new_users": {
          "$ref": "#/$defs/distribution"
        },
        "actions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/action_frequency"
          }
        }
      },
      "required": [
        "num_apps"
      ]
    },
    "user": {
      "type": "object",
      "properties": {
        "num_users": {
          "type": "integer",
          "minimum": 0
        },
        "spatial_distribution": {
          "type": "object",
          "properties": {
            "model": {
              "type": "string"
            },
            "hotspots": {
              "type": "integer"
            },
            "spread": {
              "type": "number"
            }
          }
        },
        "spatial_region": {
          "type": "object",
          "properties": {
            "width": {
              "type": "number"
            },
            "height": {
              "type": "number"
            },
            "num_vertical_streets": {
              "type": "integer"
            },
            "num_horizontal_streets": {
              "type": "integer"
            }
          }
        },
        "mobility": {
          "type": "object",
          "properties": {
            "model": {
              "type": "string"
            },
            "turn_probabilities": {
              "type": "object"
            },
            "speed": {
              "oneOf": [
                {
                  "type": "number"
                },
                {
                  "$ref": "#/$defs/distribution"
                }
              ]
            },
            "coverage_radius": {
              "oneOf": [
                {
                  "type": "number"
                },
                {
                  "$ref": "#/$defs/distribution"
                }
              ]
            }
          }
        },
        "request_ratio": {
          "$ref": "#/$defs/distribution"
        },
        "request_popularity": {
          "$ref": "#/$defs/distribution"
        },
        "actions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/action_frequency"
          }
        }
      },
      "required": [
        "num_users"
      ]
    },
    "global_spawner": {
      "type": "object",
      "properties": {
        "actions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/global_action"
          }
        }
      }
    },
    "setup": {
      "type": "object",
      "properties": {
        "solver": {
          "type": "string",
          "enum": [
            "single-objective",
            "multi-objective",
            "greedy"
          ]
        },
        "infeasible_penalty": {
          "type": "number"
        },
        "greedy_solver": {
          "type": "object"
        },
        "ilp_solver": {
          "type": "object",
          "properties": {
            "timeLimit": {
              "type": "integer"
            },
            "gapRel": {
              "type": "number"
            },
            "weights": {
              "type": "object",
              "properties": {
                "latency": {
                  "type": "number"
                },
                "migration": {
                  "type": "number"
                },
                "server_usage": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    },
    "trigger_policy": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "solve_all",
            "solve_none",
            "solve_every_t_seconds",
            "solve_every_n_events",
            "solve_on_event_types",
            "solve_random_prob",
            "solve_time_windows",
            "solve_event_index_ranges",
            "solve_custom_pattern",
            "combined"
          ]
        },
        "interval_seconds": {
          "type": "number"
        },
        "batch_size": {
          "type": "integer"
        },
        "critical_events": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "probability": {
          "type": "number"
        },
        "windows": {
          "type": "array",
          "items": {
            "type": "array"
          }
        },
        "ranges": {
          "type": "array",
          "items": {
            "type": "array"
          }
        },
        "pattern": {
          "type": "array",
          "items": {
            "type": "boolean"
          }
        }
      },
      "required": [
        "type"
      ]
    }
  },
  "anyOf": [
    {
      "required": [
        "scenario_name",
        "infrastructure",
        "app",
        "user"
      ]
    },
    {
      "required": [
        "solver_name",
        "setup",
        "trigger_policy"
      ]
    },
    {
      "required": [
        "setup",
        "infrastructure",
        "app",
        "user"
      ]
    }
  ]
}